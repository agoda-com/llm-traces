{
  "extends": "./.config/tsconfig.json",
  "compilerOptions": {
    "rootDir": ".",
    "baseUrl": "src",
    "jsx": "react",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "types": ["node", "react", "react-dom"],
    "target": "es2020",
    "lib": ["dom", "dom.iterable", "es2020"],
    "strict": true
  },
  "include": ["src", "tests/**/*.ts", ".config/types"],
  "exclude": ["node_modules", "dist"]
}
