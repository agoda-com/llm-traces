{
  "name": "llm-traces-app",
  "version": "0.0.1",
  "description": "Grafana app plugin for visualizing LLM traces stored in Tempo",
  "license": "Apache-2.0",
  "author": "Agoda",
  "repository": {
    "type": "git",
    "url": "https://github.com/agoda-com/llm-traces.git"
  },
  "homepage": "https://github.com/agoda-com/llm-traces",
  "bugs": {
    "url": "https://github.com/agoda-com/llm-traces/issues"
  },
  "keywords": ["grafana", "llm", "traces", "openinference", "observability", "genai", "otel", "tempo"],
  "private": true,
  "scripts": {
    "build": "NODE_OPTIONS='--experimental-strip-types --no-warnings=ExperimentalWarning' webpack -c ./webpack.config.ts --env production",
    "dev": "NODE_OPTIONS='--experimental-strip-types --no-warnings=ExperimentalWarning' webpack -w -c ./webpack.config.ts --env development",
    "build:standalone": "webpack --config webpack.config.standalone.js --env production",
    "build:host": "npx --yes tsx scripts/build-host.mjs",
    "dev:host": "npx --yes tsx scripts/build-host.mjs --watch",
    "test": "node --experimental-strip-types --no-warnings=ExperimentalWarning tests/llmUtils.unit.test.ts && node --import ./tests/node-loader.mjs --experimental-strip-types --no-warnings=ExperimentalWarning tests/tempoClient.unit.test.ts && node --experimental-strip-types --no-warnings=ExperimentalWarning tests/costUtils.unit.test.ts && node --experimental-strip-types --no-warnings=ExperimentalWarning tests/formatUtils.unit.test.ts && node --experimental-strip-types --no-warnings=ExperimentalWarning tests/prism-traceql.unit.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/ tests/ --max-warnings 0",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "prepare": "husky"
  },
  "devDependencies": {
    "@playwright/test": "1.50.1",
    "@types/node": "22.15.0",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "copy-webpack-plugin": "12.0.2",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "husky": "^9.1.7",
    "ts-loader": "9.5.2",
    "typescript": "5.5.4",
    "typescript-eslint": "^8.58.0",
    "webpack": "5.95.0",
    "webpack-cli": "5.1.4"
  },
  "peerDependencies": {
    "@grafana/data": ">=11.1.0",
    "@grafana/runtime": ">=11.1.0",
    "@grafana/ui": ">=11.1.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  },
  "dependencies": {
    "@emotion/css": "11.13.5",
    "marked": "^16.0.0"
  },
  "engines": {
    "node": ">=22.6"
  }
}
