{
  "$schema": "https://raw.githubusercontent.com/grafana/grafana/main/docs/sources/developers/plugins/plugin.schema.json",
  "type": "app",
  "name": "LLM Traces",
  "id": "agoda-llmtraces-app",
  "info": {
    "keywords": ["llm", "traces", "tempo", "openinference", "genai", "otel", "observability"],
    "description": "Explore LLM traces stored in Grafana Tempo. Inspect prompts, responses, tool calls, token usage and estimated cost for OpenInference, OTel GenAI and Vertex AI spans.",
    "author": { "name": "Agoda", "url": "https://github.com/agoda-com" },
    "links": [
      { "name": "Documentation", "url": "https://github.com/agoda-com/llm-traces#readme" },
      { "name": "Repository", "url": "https://github.com/agoda-com/llm-traces" },
      { "name": "Issues", "url": "https://github.com/agoda-com/llm-traces/issues" },
      { "name": "License", "url": "https://github.com/agoda-com/llm-traces/blob/main/LICENSE" }
    ],
    "logos": { "small": "img/logo.svg", "large": "img/logo.svg" },
    "screenshots": [
      { "name": "A multi-agent trace: span tree with agent rails, agent graph and an LLM span with a tool call", "path": "img/llm-traces-screenshot.png" },
      { "name": "Tool result, the model's next tool call and the tool catalog with one tool expanded", "path": "img/llm-traces-tool-catalog.png" },
      { "name": "Agent graph with a node selected, stepping through its calls", "path": "img/llm-traces-agent-graph.png" }
    ],
    "version": "%VERSION%",
    "updated": "%TODAY%"
  },
  "includes": [
    {
      "type": "page",
      "name": "LLM Traces",
      "path": "/a/%PLUGIN_ID%",
      "role": "Viewer",
      "addToNav": true,
      "defaultNav": true,
      "icon": "ai-sparkle"
    }
  ],
  "dependencies": {
    "grafanaDependency": ">=11.3.0",
    "plugins": []
  }
}
