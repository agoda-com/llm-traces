{
  "$schema": "https://raw.githubusercontent.com/grafana/grafana/main/docs/sources/developers/plugins/plugin.schema.json",
  "type": "app",
  "name": "LLM Traces",
  "id": "llm-traces-app",
  "info": {
    "keywords": ["llm", "traces", "openinference", "observability", "genai", "otel"],
    "description": "LLM trace visualization for OpenInference, OTel GenAI and Vertex AI spans stored in Grafana Tempo",
    "author": { "name": "Agoda", "url": "https://github.com/agoda-com" },
    "links": [
      { "name": "Repository", "url": "https://github.com/agoda-com/llm-traces" },
      { "name": "Issues", "url": "https://github.com/agoda-com/llm-traces/issues" },
      { "name": "License", "url": "https://github.com/agoda-com/llm-traces/blob/main/LICENSE" }
    ],
    "logos": { "small": "img/logo.svg", "large": "img/logo.svg" },
    "screenshots": [
      { "name": "LLM Traces", "path": "img/llm-traces-screenshot.png" }
    ],
    "version": "%VERSION%",
    "updated": "%TODAY%"
  },
  "includes": [
    {
      "type": "page",
      "name": "LLM Traces",
      "path": "/a/%PLUGIN_ID%",
      "role": "Viewer",
      "addToNav": true,
      "defaultNav": true,
      "icon": "ai-sparkle"
    }
  ],
  "dependencies": {
    "grafanaDependency": ">=11.3.0",
    "plugins": []
  }
}
